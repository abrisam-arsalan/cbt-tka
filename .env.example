APP_NAME="Panglima CBT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona waktu server sekolah. PENTING: seluruh timer, deadline, dan grace period
# ujian dihitung dari zona waktu ini. Jangan biarkan UTC jika sekolah berada di WIB.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Jumlah worker PHP built-in server. Hanya relevan untuk `php artisan serve`.
# Di produksi pakai nginx/apache, bukan artisan serve.
# PHP_CLI_SERVER_WORKERS=4

# BCRYPT_ROUNDS=12 menaikkan biaya hashing password.
# Turunkan ke 10 bila CPU server sekolah lemah.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pakai driver "mariadb" untuk MariaDB, atau "mysql" untuk MySQL/Percona.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_tka
DB_USERNAME=cbt
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / Queue / Cache
# ---------------------------------------------------------------------------
# SESSION_DRIVER=database penting untuk 200 siswa concurrent: driver "file"
# menulis satu file per sesi dan sangat lambat di HDD.
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=cbt_tka_cache_

# ---------------------------------------------------------------------------
# Redis (opsional)
# ---------------------------------------------------------------------------
# Tanpa Redis biarkan CBT_PRESENCE_DRIVER=database; aplikasi tetap berjalan penuh.
# REDIS_CLIENT=predis (murni PHP, tanpa ekstensi) atau phpredis (lebih cepat).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cbt@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CBT TKA Sekolah
# ---------------------------------------------------------------------------

# Driver presence/heartbeat siswa: "redis" atau "database".
CBT_PRESENCE_DRIVER=database
# Detik sejak heartbeat terakhir sebelum siswa dianggap offline.
CBT_PRESENCE_ONLINE_SECONDS=45
# Interval heartbeat dari browser siswa (detik). Jangan di bawah 15.
CBT_HEARTBEAT_INTERVAL_SECONDS=20

# Debounce auto-save jawaban di browser (ms).
CBT_AUTOSAVE_DEBOUNCE_MS=1000
# Interval flush outbox saat koneksi pulih (ms).
CBT_OUTBOX_FLUSH_INTERVAL_MS=3000
# Jumlah maksimum jawaban per request sinkronisasi.
CBT_MAX_SYNC_BATCH=50

# Grace period default bila kolom offline_grace_minutes pada ujian kosong.
CBT_DEFAULT_OFFLINE_GRACE_MINUTES=10
# Batas peringatan anti-cheat default.
CBT_DEFAULT_ANTI_CHEAT_MAX_WARNINGS=3
# Jumlah attempt yang diproses scheduler auto-submit per putaran.
CBT_EXPIRE_SWEEP_CHUNK=200

# Panjang token ujian dan alphabet-nya (tanpa karakter ambigu I, O, 0, 1).
CBT_TOKEN_LENGTH=8
CBT_TOKEN_ALPHABET=ABCDEFGHJKLMNPQRSTUVWXYZ23456789

# Rate limiting login.
CBT_LOGIN_MAX_ATTEMPTS=5
CBT_LOGIN_DECAY_SECONDS=60

# Kartu ujian.
CBT_CARD_SCHOOL_NAME="${APP_NAME}"
# Path relatif terhadap storage/app/public, mis. "logo/sekolah.png".
CBT_CARD_LOGO_PATH=
CBT_CARD_QR_SIZE=180

# Di belakang Cloudflare Tunnel, set true agar route()/asset() memakai https.
CBT_FORCE_HTTPS=false
# Cloudflare Tunnel meneruskan request dari localhost, jadi "*" aman di sini.
TRUSTED_PROXIES="*"
